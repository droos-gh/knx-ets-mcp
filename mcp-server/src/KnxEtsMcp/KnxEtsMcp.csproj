<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- MCP server bridging LLM tool calls to the KNX ETS AddIn (named pipe / TCP).
       Client-facing transports: Streamable HTTP (default) or stdio.
       Released as a self-contained single-file Windows exe (see release.yml). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>KnxEtsMcp</RootNamespace>
    <AssemblyName>knx-ets-mcp</AssemblyName>
    <Version>0.4.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>../../packaging/icon.ico</ApplicationIcon>
    <!-- Tool parameter names are part of the MCP schema and stay snake_case
         (device_ref, expected_project_revision, ...) for client compatibility. -->
    <NoWarn>$(NoWarn);IDE1006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KnxEtsMcp.Tests" />
  </ItemGroup>

</Project>
